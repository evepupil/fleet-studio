{
  "name": "fleet-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @fleet/web typecheck",
    "test": "vitest run",
    "build": "tsc -b && pnpm --filter @fleet/web build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
