{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    /** 有意不引入 @types/node：核心层不准 import 任何 node: 模块，缺了 node 类型能让这条规则在编译期就露馅。 */
    "types": []
  },
  "include": ["src/**/*.ts"]
}
